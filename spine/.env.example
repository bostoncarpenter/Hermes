# Copy to spine/.env and fill in.
# mem0 API + dashboard are built from this pinned upstream commit (mem0ai/mem0).
MEM0_REF=b51f7692f002d4f8719dd5c0f23d4d129003757d
# setup-mac.sh fills these with `openssl rand -hex 32` when it creates .env.
POSTGRES_PASSWORD=
JWT_SECRET=
# Free key from https://aistudio.google.com — powers mem0's LLM + embedder.
GOOGLE_API_KEY=
# Issued by the dashboard wizard at http://localhost:3000 after first boot.
# Paste it here AND into ~/.hermes/.env as MEM0_API_KEY.
MEM0_API_KEY=
