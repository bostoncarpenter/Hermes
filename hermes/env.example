# ~/.hermes/.env
# Memory spine
MEM0_HOST=http://localhost:8888
MEM0_API_KEY=          # from dashboard wizard at http://localhost:3000
# Telegram gateway (from @BotFather); comma-separated Telegram user IDs
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# openai-codex and xai-oauth are OAuth logins — no keys here;
# run `hermes auth add openai-codex` / `hermes auth add xai-oauth`.
