# Copy to spine/.env and fill in.
POSTGRES_PASSWORD=change-me
# Required by mem0 api server. Any long random string.
JWT_SECRET=change-me-long-random
# Free key from https://aistudio.google.com — powers mem0's LLM + embedder.
GOOGLE_API_KEY=
# Issued by the dashboard wizard at http://localhost:3000 after first boot.
# Paste it here AND into ~/.hermes/.env as MEM0_API_KEY.
MEM0_API_KEY=
