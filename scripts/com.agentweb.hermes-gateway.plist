<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agentweb.hermes-gateway</string>
  <!-- `hermes gateway` (bare) runs in the foreground; start/stop daemonize -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec hermes gateway</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/agentweb-hermes-gateway.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/agentweb-hermes-gateway.err.log</string>
</dict>
</plist>
